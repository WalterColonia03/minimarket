# ==========================================
# VARIABLES DE ENTORNO - MINIMARKET
# ==========================================

# 1. Base de Datos (PostgreSQL)
# URL de conexión a tu base de datos (Ej: Neon, Supabase, Render, Railway)
DATABASE_URL=postgresql://usuario:contraseña@host:5432/nombre_bd

# Habilitar SSL (Requerido en proveedores cloud como Neon o Supabase)
DB_SSL=true

# 2. Autenticación (JWT)
# Secreto para firmar los tokens de sesión (usa una cadena larga y aleatoria)
JWT_SECRET=un_secreto_super_seguro_y_largo_para_jwt
# Tiempo de expiración de la sesión (ej: 7d, 24h)
JWT_EXPIRES_IN=7d

# 3. Servidor (Desarrollo local)
PORT=3000
# CORS_ORIGIN=http://localhost:5173

# 4. APIs Externas (Consulta DNI/RUC)
# Token para buscar datos de clientes por DNI/RUC en decolecta o apis.net.pe
APIS_PERU_TOKEN=tu_token_de_apis_peru_aqui

# 5. Envío de Correos (Recuperación de contraseña) - Opcional
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=tu_contraseña_de_aplicacion
